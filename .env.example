# Copie para .env (desenvolvimento local) ou cadastre no painel do provedor.
# Nunca versione o .env real.

# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Desenvolvimento local: DEBUG=true. Produção: false (padrão).
DEBUG=false

# Domínios que podem servir a API, separados por vírgula.
# No Render, o domínio público (RENDER_EXTERNAL_HOSTNAME) é adicionado automaticamente.
ALLOWED_HOSTS=localhost,127.0.0.1

# Endereços do frontend autorizados a chamar a API (ex.: https://seu-app.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Origens confiáveis para o /admin em HTTPS (opcional).
CSRF_TRUSTED_ORIGINS=

# Produção atrás de HTTPS (Render): true liga redirecionamento, cookies seguros e HSTS.
SECURE_HTTPS=false
SECURE_HSTS_SECONDS=3600

# Banco SQLite (padrão: data/db.sqlite3).
SQLITE_PATH=

# Validade dos tokens JWT.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Limite de tentativas de login (e de troca de senha) por IP.
LOGIN_THROTTLE_RATE=10/min
# Atrás de proxy (Render): quantos proxies adicionam X-Forwarded-For, para o
# limite usar o IP real do visitante. Vazio = usa o IP da conexão.
THROTTLE_NUM_PROXIES=
